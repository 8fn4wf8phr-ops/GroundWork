# Firebase project config — from Firebase Console > Project settings > General
# > Your apps > SDK setup and configuration. Copy this file to .env.local
# (already gitignored) and fill in your project's values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Adzuna job search API — register (free) at developer.adzuna.com.
# Server-only: no NEXT_PUBLIC_ prefix, since app_key is tied to your rate
# quota and must never reach the browser bundle.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Claude API key — from console.anthropic.com (Settings > API Keys).
# Server-only: powers the agent system (Compass/Scout/Ledger commentary,
# the disagreement + "Needs your call" mechanic).
ANTHROPIC_API_KEY=

# Scheduled (daily) discovery — see lib/server/scheduled-discovery.ts.
# Both are server-only secrets; set them as Sensitive env vars on Vercel.
#
# CRON_SECRET: any long random string (e.g. `openssl rand -hex 32`). Vercel
# sends it as `Authorization: Bearer <secret>` when it triggers the cron, and
# /api/cron/discover refuses every request without it.
CRON_SECRET=
# FIREBASE_SERVICE_ACCOUNT: the JSON key from Firebase Console > Project
# settings > Service accounts > Generate new private key — paste the whole
# file contents (or the base64 of it). This gives the server Admin access
# that BYPASSES Firestore security rules; treat it like a password.
FIREBASE_SERVICE_ACCOUNT=

# USAJobs API — register (free) at developer.usajobs.gov/apirequest.
# Server-only: Authorization-Key is tied to the registrant's identity,
# and User-Agent must be the exact email registered under (per USAJobs'
# own auth docs), so both stay out of the browser bundle.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Email notifications (follow-up reminders, new matches, the weekly
# digest, tailored-materials copies) — see lib/email.ts. Sign up (free) at
# resend.com for RESEND_API_KEY; server-only, same reasoning as every
# other paid key above. Where each email actually goes is set per-account
# on the Profile page (notificationEmail), not here.
RESEND_API_KEY=
# EMAIL_FROM: optional. Defaults to Resend's own shared sending domain
# (onboarding@resend.dev), which works with no setup. Override once
# you've verified your own domain in Resend, e.g.
# `Groundwork <notifications@yourdomain.com>`.
EMAIL_FROM=

# Error logging (Sentry, optional) — sign up (free) at sentry.io, create a
# Next.js project, and its "Client Keys (DSN)" page has this value. Unset
# means no error reporting at all (Sentry.init() with no dsn is a
# documented no-op), same skip-if-unset pattern as every integration
# above. The DSN itself is meant to be public (same as Firebase's client
# config) — it identifies where to send events, not a credential — which
# is why it's a NEXT_PUBLIC_ var even though it's also read server-side.
NEXT_PUBLIC_SENTRY_DSN=
# The three below are optional and ONLY affect source-map upload at build
# time (so a Sentry stack trace shows your real file/line instead of
# minified output) — error reporting itself works with just the DSN
# above. From Sentry's organization/project settings and
# sentry.io/settings/account/api/auth-tokens/ respectively.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
