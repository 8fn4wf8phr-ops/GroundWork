rules_version = '2';

// Spec ref: groundwork-spec.md Section 5 — every document carries an
// ownerId, and no read or write is allowed unless request.auth.uid matches
// it. There is no wide-open "test mode" fallback here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(resourceOwnerId) {
      return request.auth != null && request.auth.uid == resourceOwnerId;
    }

    function isOwnerOnCreate() {
      return request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // Guards update specifically: isOwner(resource.data.ownerId) alone only
    // checks who owns the document BEFORE the write, not what the write
    // changes ownerId TO. Confirmed live via a real ID token hitting the
    // Firestore REST API directly: without this, an authenticated owner
    // could PATCH their own job/application/contact/etc. and set its
    // ownerId to a DIFFERENT uid, which — since every query in this app
    // filters by ownerId == auth.uid — effectively plants an
    // attacker-controlled document into another user's own Review queue,
    // Applications board, Contacts, or Case File. Every ownerId-field
    // collection below checks this on update so ownerId can never change
    // after creation.
    function ownerIdUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // Profile documents are keyed by the owner's own uid (see
    // lib/firestore/profile.ts), so the path itself proves ownership —
    // unlike the collections below, this doesn't need to read
    // resource.data, which matters because resource is null when the
    // document doesn't exist yet (a first-time user's Profile read).
    match /profiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == profileId;
    }

    // Same fix as profiles above: Resume is a uid-keyed singleton too, so
    // this checks the path instead of resource.data — a resource.data
    // check breaks on a first-time user's read (no document exists yet,
    // so `resource` is null and `resource.data.ownerId` throws).
    match /resumes/{resumeId} {
      allow read, write: if request.auth != null && request.auth.uid == resumeId;
    }

    match /jobs/{jobId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }

    match /applications/{applicationId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }

    match /contacts/{contactId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }

    match /caseFileEntries/{entryId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }

    // Deliberately NOT keyed by applicationId (unlike profiles/resumes'
    // uid-keying) — that would reintroduce the null-resource-on-first-read
    // problem those two hit, since applicationId isn't the auth uid. Same
    // random-id + query-by-ownerId pattern as jobs/applications/contacts
    // instead, which never touches a possibly-nonexistent specific doc.
    match /tailoredMaterials/{entryId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }

    // Same random-id + query-by-ownerId pattern as jobs/applications/
    // contacts/tailoredMaterials above (Herald outreach drafts).
    match /outreach/{outreachId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwnerOnCreate();
    }
  }
}
